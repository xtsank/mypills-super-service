# Учётные данные PostgreSQL
DB_USER=mypills
DB_PASSWORD=
DB_NAME=mypills

# Адрес PostgreSQL для запуска Go вне Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Пул соединений Go с PostgreSQL
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=5m

# Логи Go-сервера
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Секрет подписи JWT и время жизни токена в секундах
SECRET_KEY=
TOKEN_DURATION=86400

# Логин и пароль для /admin/
ADMIN_USER=webadmin
ADMIN_PASSWORD=

# Порт Go при запуске напрямую и внутри контейнера
SERVER_PORT=8080
APP_PORT=8081

# Порт GUI при запуске напрямую и внешний порт Nginx
GUI_PORT=5173
WEB_PORT=8088
