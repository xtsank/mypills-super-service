      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lab3-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH counts AS (\n    SELECT duration_ns,\n           count(*) FILTER (WHERE variant = 'sql' AND (scenario <> 'mixed' OR operation = 'page')) AS sql_main,\n           count(*) FILTER (WHERE variant = 'gorm' AND (scenario <> 'mixed' OR operation = 'page')) AS gorm_main,\n           count(*) FILTER (WHERE variant = 'sql' AND scenario = 'mixed' AND operation = 'rename') AS sql_write,\n           count(*) FILTER (WHERE variant = 'gorm' AND scenario = 'mixed' AND operation = 'rename') AS gorm_write\n    FROM lab3_samples WHERE run_id = ${run_id:sqlstring} AND scenario = ${scenario:sqlstring} AND repeat = ${repeat:sqlstring}::integer\n      AND phase = 'measure' AND status = 'ok'\n    GROUP BY duration_ns\n)\nSELECT duration_ns / 1e6 AS \"Задержка\",\n       100.0 * sum(sql_main) OVER sorted / nullif(sum(sql_main) OVER (), 0) AS \"SQL\",\n       100.0 * sum(gorm_main) OVER sorted / nullif(sum(gorm_main) OVER (), 0) AS \"GORM\",\n       100.0 * sum(sql_write) OVER sorted / nullif(sum(sql_write) OVER (), 0) AS \"SQL · запись\",\n       100.0 * sum(gorm_write) OVER sorted / nullif(sum(gorm_write) OVER (), 0) AS \"GORM · запись\"\nFROM counts\nWINDOW sorted AS (ORDER BY duration_ns)\nORDER BY duration_ns"
        }
      ],
