    {
      "id": 6,
      "type": "table",
      "title": "Время и число операций по фазам",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lab3-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lab3-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH phases AS (\n    SELECT item\n    FROM lab3_runs CROSS JOIN LATERAL jsonb_array_elements(summary->'series') AS item\n    WHERE run_id = ${run_id:sqlstring}\n      AND item->>'scenario' = ${scenario:sqlstring}\n      AND (item->>'repeat')::integer = ${repeat:sqlstring}::integer\n)\nSELECT upper(item->>'variant') AS \"Вариант\", label AS \"Фаза\",\n       (item->phase->>'operations')::bigint AS \"Операции\",\n       (item->phase->>'duration_ns')::bigint / 1e9 AS \"Длительность\"\nFROM phases CROSS JOIN (VALUES ('warmup', 'Прогрев', 1),\n    ('measure', 'Измерение', 2), ('teardown', 'Завершение', 3)) AS phase_names(phase, label, sort)\nORDER BY item->>'variant' DESC, sort"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
