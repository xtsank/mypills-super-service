    {
      "id": 3,
      "type": "xychart",
      "pluginVersion": "12.3.3",
      "title": "Задержка во времени",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lab3-postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lab3-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH samples AS (\n    SELECT *, offset_ns - min(offset_ns) OVER (PARTITION BY variant) AS elapsed_ns\n    FROM lab3_samples WHERE run_id = ${run_id:sqlstring} AND scenario = ${scenario:sqlstring} AND repeat = ${repeat:sqlstring}::integer\n      AND phase = 'measure' AND status = 'ok'\n)\nSELECT elapsed_ns / 1e9 AS \"Время\",\n       max(duration_ns) FILTER (WHERE variant = 'sql' AND (scenario <> 'mixed' OR operation = 'page')) / 1e6 AS \"SQL\",\n       max(duration_ns) FILTER (WHERE variant = 'gorm' AND (scenario <> 'mixed' OR operation = 'page')) / 1e6 AS \"GORM\",\n       max(duration_ns) FILTER (WHERE variant = 'sql' AND scenario = 'mixed' AND operation = 'rename') / 1e6 AS \"SQL · запись\",\n       max(duration_ns) FILTER (WHERE variant = 'gorm' AND scenario = 'mixed' AND operation = 'rename') / 1e6 AS \"GORM · запись\"\nFROM samples\nGROUP BY elapsed_ns\nORDER BY elapsed_ns"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
