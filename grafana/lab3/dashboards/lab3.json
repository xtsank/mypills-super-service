          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH p AS (\n    SELECT variant, operation, count(*) AS samples,\n           percentile_disc(ARRAY[0.50, 0.75, 0.90, 0.95, 0.99])\n               WITHIN GROUP (ORDER BY duration_ns) AS quantiles\n    FROM lab3_samples WHERE run_id = ${run_id:sqlstring} AND scenario = ${scenario:sqlstring} AND repeat = ${repeat:sqlstring}::integer\n  AND phase = 'measure' AND status = 'ok'\n    GROUP BY variant, operation\n)\nSELECT upper(variant) AS \"Вариант\", operation AS \"Операция\", samples AS \"Замеры\",\n       quantiles[1] / 1e6 AS p50, quantiles[2] / 1e6 AS p75, quantiles[3] / 1e6 AS p90,\n       quantiles[4] / 1e6 AS p95, quantiles[5] / 1e6 AS p99\nFROM p ORDER BY operation, variant DESC"
        }
