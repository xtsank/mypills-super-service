FROM docker:28.5.2-cli AS docker

FROM golang:1.26.2-alpine

COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose

RUN apk add --no-cache build-base make nodejs npm openjdk17-jre-headless

WORKDIR /opt/allure
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

ENV CGO_ENABLED=1

CMD ["make", "test"]
